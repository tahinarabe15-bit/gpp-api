# ============================================================
# GPP FONDS — Configuration API
# Copiez ce fichier en .env et remplissez vos vraies valeurs
# ============================================================

# --- CONNEXION POSTGRESQL ---
# Serveur où tourne PostgreSQL (localhost si même machine)
DB_HOST=localhost
# Port PostgreSQL (défaut : 5432)
DB_PORT=5432
# Nom de votre base de données
DB_NAME=postgres
# Utilisateur PostgreSQL
DB_USER=postgres
# Mot de passe PostgreSQL
DB_PASSWORD=gpp2024

# --- SERVEUR API ---
# Port sur lequel l'API écoute
PORT=3000

# --- SÉCURITÉ ---
# Clé secrète pour les tokens JWT (changez cette valeur !)
JWT_SECRET=gpp_secret_changez_ceci_2026

# --- PARAMÈTRES GPP ---
# IFP par défaut
IFP_NOM=PAMF
IFP_ID_GPP=PAMF_GPP_DIGITAUX
# Stop Loss PAMF en % (30%)
STOP_LOSS_PCT=30

# --- INFORMATIONS SIGNATAIRES ---
SIGNATAIRE_NOM=Aina RAFELIARISOA
SIGNATAIRE_TITRE=Directeur Général Adjoint
SIGNATAIRE2_NOM=Jean Marc RAVELOMANANTSOA
SIGNATAIRE2_TITRE=Directeur Général

# --- ORGANISATION ---
ORG_NOM=GPP SOLIDIS
ORG_VILLE=Antananarivo

# Optimisations
DEBUG=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000